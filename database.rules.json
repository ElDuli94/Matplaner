{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !root.child('admins').exists() && auth.token.email.toLowerCase() === 'ADMIN-EPOST@eksempel.no'))",
        ".validate": "newData.val() === true"
      }
    },

    "members": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && newData.exists()))",
        ".validate": "newData.hasChildren(['email', 'joined']) && (root.child('admins').child(auth.uid).val() === true || (newData.child('invite').isString() && root.child('invites').child(newData.child('invite').val()).exists() && root.child('invites').child(newData.child('invite').val()).child('email').val() === auth.token.email.toLowerCase() && !root.child('invites').child(newData.child('invite').val()).child('usedBy').exists() && root.child('invites').child(newData.child('invite').val()).child('expires').val() > now))"
      }
    },

    "invites": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$token": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "usedBy": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('invites').child($token).child('email').val() === auth.token.email.toLowerCase()"
        }
      }
    },

    "requests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.child('email').isString()"
      }
    },

    "family": {
      ".read": "auth != null && (root.child('members').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('members').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)",
      "lists": {
        "$week": {
          ".validate": "$week.matches(/^[0-9]{4}-W[0-9]{2}$/)"
        }
      }
    }
  }
}
