{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !root.child('admins').exists() && auth.token.email.toLowerCase() === 'ADMIN-EPOST@eksempel.no'))",
        ".validate": "newData.val() === true"
      }
    },
    "familyIndex": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$fid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && newData.exists()) || (!newData.exists() && root.child('families').child(data.child('family').val()).child('members').child(auth.uid).child('role').val() === 'owner'))",
        ".validate": "newData.hasChildren(['email', 'family', 'role']) && (newData.child('role').val() === 'owner' || newData.child('role').val() === 'member') && (root.child('admins').child(auth.uid).val() === true || (newData.child('invite').isString() && root.child('invites').child(newData.child('invite').val()).exists() && root.child('invites').child(newData.child('invite').val()).child('email').val() === auth.token.email.toLowerCase() && !root.child('invites').child(newData.child('invite').val()).child('usedBy').exists() && root.child('invites').child(newData.child('invite').val()).child('expires').val() > now && root.child('invites').child(newData.child('invite').val()).child('family').val() === newData.child('family').val() && root.child('invites').child(newData.child('invite').val()).child('role').val() === newData.child('role').val()))"
      }
    },
    "families": {
      "$fid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "info": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('families').child($fid).child('members').child(auth.uid).exists())"
        },
        "members": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('families').child($fid).child('members').child(auth.uid).exists())",
          "$uid": {
            ".write": "auth != null && ((!newData.exists() && root.child('families').child($fid).child('members').child(auth.uid).child('role').val() === 'owner') || (auth.uid === $uid && !data.exists() && newData.exists()))",
            ".validate": "newData.hasChildren(['email', 'role']) && (newData.child('role').val() === 'owner' || newData.child('role').val() === 'member') && (root.child('admins').child(auth.uid).val() === true || (newData.child('invite').isString() && root.child('invites').child(newData.child('invite').val()).exists() && root.child('invites').child(newData.child('invite').val()).child('email').val() === auth.token.email.toLowerCase() && !root.child('invites').child(newData.child('invite').val()).child('usedBy').exists() && root.child('invites').child(newData.child('invite').val()).child('expires').val() > now && root.child('invites').child(newData.child('invite').val()).child('family').val() === $fid && root.child('invites').child(newData.child('invite').val()).child('role').val() === newData.child('role').val()))"
          }
        },
        "items": {
          ".read": "auth != null && root.child('families').child($fid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && root.child('families').child($fid).child('members').child(auth.uid).exists()",
          "$id": {
            ".validate": "newData.hasChildren(['name', 'cat']) && newData.child('name').isString() && newData.child('name').val().length <= 80"
          }
        },
        "learned": {
          ".read": "auth != null && root.child('families').child($fid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && root.child('families').child($fid).child('members').child(auth.uid).exists()"
        }
      }
    },
    "invites": {
      ".indexOn": [
        "family"
      ],
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (query.orderByChild === 'family' && query.equalTo === root.child('users').child(auth.uid).child('family').val() && root.child('users').child(auth.uid).child('role').val() === 'owner'))",
      "$token": {
        ".read": true,
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.exists() && newData.child('role').val() === 'member' && root.child('families').child(newData.child('family').val()).child('members').child(auth.uid).child('role').val() === 'owner') || (data.exists() && !newData.exists() && root.child('families').child(data.child('family').val()).child('members').child(auth.uid).child('role').val() === 'owner'))",
        ".validate": "newData.hasChildren(['email', 'family', 'role', 'expires'])",
        "usedBy": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('invites').child($token).child('email').val() === auth.token.email.toLowerCase()"
        }
      }
    },
    "requests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.child('email').isString()"
      }
    }
  }
}